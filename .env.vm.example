# .env.vm.example — Configuración POR VM
# Copiar a .env en la raíz del repositorio y ajustar con las IPs
# Tailscale REALES de esta VM y de las otras dos.
#
#   cp .env.vm.example .env
#
# Cambiar todos los valores 100.x.x.N por las IPs reales de Tailscale.
# NUNCA subir .env al repositorio.
# =============================================================

# ── Identidad de ESTA VM ─────────────────────────────────────
# NODE_ID determina qué perfil de docker compose se activa:
#   1 → servicios: mongod + nodo1
#   2 → servicios: mongod + nodo2
#   3 → servicios: mongod + nodo3 + rabbitmq + mongo-init  (coordinador)
NODE_ID=1

# IP Tailscale de ESTA VM (la que ven los otros nodos)
NODE_HOST=100.x.x.1

# Puerto gRPC del nodo Go (igual en las 3 VMs)
NODE_PORT=5000

# ── Peers (los OTROS dos nodos) ──────────────────────────────
# No incluir esta VM. Formato: ID@IP:PUERTO separado por comas.
PEERS=2@100.x.x.2:5000,3@100.x.x.3:5000

# ── MongoDB Replica Set ──────────────────────────────────────
DB_URI=mongodb://100.x.x.1:27017,100.x.x.2:27017,100.x.x.3:27017/?replicaSet=rs-grupo&w=majority&wtimeoutMS=5000&retryWrites=true
DB_NAME=inventory
DB_NODE_COLLECTION=nodes

# IPs de los 3 miembros del Replica Set
# (Solo las usa mongo-init en VM3; definirlas en todas simplifica la gestión)
RS_MEMBER_1=100.x.x.1:27017
RS_MEMBER_2=100.x.x.2:27017
RS_MEMBER_3=100.x.x.3:27017

# ── RabbitMQ ─────────────────────────────────────────────────
# RabbitMQ corre SOLO en VM3 (coordinador, NODE_ID=3).
# VM1 y VM2 apuntan a la IP Tailscale del coordinador.
# VM3 usa localhost (el compose lo sobreescribe automáticamente).
RABBITMQ_URL=amqp://sd_user:cambiar_esta_clave@100.x.x.3:5672/
RABBITMQ_USER=sd_user
RABBITMQ_PASS=cambiar_esta_clave
RABBITMQ_METRICS_QUEUE=metrics
RABBITMQ_ALLOCATIONS_QUEUE=allocations
RABBITMQ_FAILOVER_QUEUE=failover

# ── Tiempos de los nodos Go ──────────────────────────────────
TIMEOUT_MS=3000
HEARTBEAT_MS=1000
CAUSAL_WINDOW_MS=3000
METRICS_INTERVAL_MS=3000
CONSUMER_PREFETCH=100
MANUAL_METRICS=false
