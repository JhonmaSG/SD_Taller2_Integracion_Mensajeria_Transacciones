# =============================================================
# .env para MÁQUINA 1 (Nodo 1 - Follower)
# IP Tailscale: 100.103.251.117
# =============================================================

NODE_ID=1
NODE_HOST=100.103.251.117
NODE_PORT=5000

# Peers: Nodo 2 y Nodo 3 (Coordinador)
PEERS=2@100.123.154.67:5000,3@100.69.45.6:5000

# MongoDB Replica Set rs-grupo
DB_URI=mongodb://100.103.251.117:27017,100.123.154.67:27017,100.69.45.6:27017/?replicaSet=rs-grupo&w=majority&wtimeoutMS=5000&retryWrites=true
DB_NAME=inventory
DB_NODE_COLLECTION=nodes

RS_MEMBER_1=100.103.251.117:27017
RS_MEMBER_2=100.123.154.67:27017
RS_MEMBER_3=100.69.45.6:27017

# RabbitMQ en Máquina 3 (Coordinador)
RABBITMQ_URL=amqp://sd_user:cambiar_esta_clave@100.69.45.6:5672/
RABBITMQ_USER=sd_user
RABBITMQ_PASS=cambiar_esta_clave
RABBITMQ_METRICS_QUEUE=metrics
RABBITMQ_ALLOCATIONS_QUEUE=allocations
RABBITMQ_FAILOVER_QUEUE=failover

# Tiempos del sistema distribuido
TIMEOUT_MS=3000
HEARTBEAT_MS=1000
CAUSAL_WINDOW_MS=3000
METRICS_INTERVAL_MS=3000
CONSUMER_PREFETCH=100
MANUAL_METRICS=false
