# .env — Variables de entorno para docker-compose
# Copia este archivo a .env y ajusta las credenciales.
#   cp .env.compose.example .env
#
# IMPORTANTE: nunca subas .env al repositorio.

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=sd_user
RABBITMQ_PASS=cambiar_esta_clave
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_METRICS_QUEUE=metrics
RABBITMQ_ALLOCATIONS_QUEUE=allocations
RABBITMQ_FAILOVER_QUEUE=failover

# ── MongoDB ──────────────────────────────────────────────────
DB_NAME=inventory
DB_NODE_COLLECTION=nodes

# ── Tiempos de los nodos Go ──────────────────────────────────
TIMEOUT_MS=3000
HEARTBEAT_MS=1000
CAUSAL_WINDOW_MS=3000
METRICS_INTERVAL_MS=3000
CONSUMER_PREFETCH=100
MANUAL_METRICS=false
