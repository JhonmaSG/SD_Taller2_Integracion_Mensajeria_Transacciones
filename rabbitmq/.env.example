# Imagen oficial de RabbitMQ con panel de administración.
RABBITMQ_IMAGE=rabbitmq:3.13-management

# Nombre estable del contenedor y hostname interno.
RABBITMQ_CONTAINER_NAME=sd-rabbitmq
RABBITMQ_HOSTNAME=rabbitmq

# Credenciales de desarrollo.
RABBITMQ_DEFAULT_USER=sd_user
RABBITMQ_DEFAULT_PASS=cambiar_esta_clave

# Virtual host predeterminado.
RABBITMQ_VHOST=/

# Direcciones y puertos publicados por Docker.
# Para desarrollo local se puede usar 127.0.0.1.
# Para acceso desde las VM por Tailscale usar 0.0.0.0 y restringir
# el acceso mediante firewall.
RABBITMQ_BIND_ADDRESS=0.0.0.0
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# URL que utilizarán los nodos Go.
# En una prueba local:
RABBITMQ_HOST=localhost

# En las VM, reemplazar localhost por la IP Tailscale de la VM
# donde se ejecuta RabbitMQ.
RABBITMQ_URL=amqp://sd_user:cambiar_esta_clave@localhost:5672/

# Nombres de las colas que utiliza el código actual.
RABBITMQ_METRICS_QUEUE=metrics
RABBITMQ_ALLOCATIONS_QUEUE=allocations
RABBITMQ_FAILOVER_QUEUE=failover
